{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "panex",
  "version": "0.7.0",
  "identifier": "dev.panex.terminal",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "panex",
        "width": 1518,
        "height": 860,
        "minWidth": 480,
        "minHeight": 300,
        "theme": "Dark",
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": { "installerHooks": "./installer-hooks.nsh" }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERCQkJGRTY1OTgxN0VCRTgKUldUbzZ4ZVlaZjY3MjE2VlBZTmgrK1MwSUwxQ25heFRkUHMvbWpsK0QxTjNrdENPMnh5S1o2RWgK",
      "endpoints": ["https://github.com/firstfu/panex/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
